<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/MainLinearLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iconView"
            android:layout_width="@dimen/household_item_icon_width"
            android:layout_height="@dimen/household_item_icon_height"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="8dp"
            android:layout_centerInParent="true"
            android:src="@mipmap/nui_household_red_icon" />

        <ImageView
            android:id="@+id/iconNewRecordView"
            android:layout_width="@dimen/household_item_icon_width"
            android:layout_height="@dimen/household_item_icon_height"
            android:layout_centerInParent="true"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="8dp"
            android:src="@mipmap/nui_new_record_icon" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical" >
    
        <TextView
            android:id="@+id/txtHousename"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center|left"
            android:gravity="left"
            android:singleLine="true"
            android:text="Large Text"
            android:textColor="@color/nui_household_item_textcolor"
            android:textSize="@dimen/household_item_text_1_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtHouseCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="Medium Text"
                android:textColor="@color/nui_household_item_textcolor"
                android:textSize="@dimen/household_item_text_2_size" />

            <TextView
                android:id="@+id/txtHouseStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="2dp"
                android:paddingBottom="5dp"
                android:background="@drawable/nui_border_txt_sgreen"
                android:text="@string/householdStatus_destroyed_short"
                android:textColor="#FFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"/>

        </LinearLayout>
        
    </LinearLayout>

    <CheckBox
        android:id="@+id/chkProcessed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:focusable="false"
        android:enabled="false"
        />

</LinearLayout>
