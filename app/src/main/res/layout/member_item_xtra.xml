<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/MainLinearLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="horizontal" >

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/iconView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="left|center"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:src="@mipmap/nui_member_red_icon" />

        <ImageView
            android:id="@+id/iconNewRecordView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="left|center"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:src="@mipmap/nui_new_record_icon" />

    </RelativeLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginRight="10dp"
        android:orientation="vertical" >

        <TextView
            android:id="@+id/txtMemberItemName"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center|left"
            android:gravity="left|center_horizontal"
            android:text="Large Text"
            android:singleLine="true"
            android:textSize="@dimen/member_item_text_1_size"
            android:textStyle="bold"
            android:textColor="@color/nui_member_item_textcolor" />
        
        <TextView
            android:id="@+id/txtMemberItemCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="Medium Text"
            android:textStyle="bold"
            android:textSize="@dimen/member_item_text_2_size"
            android:textColor="@color/nui_member_item_textcolor" />

        <TextView
            android:id="@+id/txtMemberItemHousehold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="Medium Text"
            android:textSize="@dimen/member_item_text_2_size"
            android:textColor="@color/nui_member_item_textcolor"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/txtMemberItemExtras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="Medium Text"
            android:textSize="@dimen/member_item_text_3_size"
            android:textStyle="bold"
            android:textColor="@color/nui_member_item_textcolor" />
        
    </LinearLayout>

</LinearLayout>
