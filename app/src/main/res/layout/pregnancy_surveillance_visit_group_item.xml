<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/nui_background_wbevel"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iconCollapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center"
            android:src="@drawable/nui_arrow_track_down_24" />

        <ImageView
            android:id="@+id/iconExpanded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center"
            android:visibility="gone"
            android:src="@drawable/nui_arrow_track_up_24" />

    </LinearLayout>

    <TextView
        android:id="@+id/txtGroupName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/pregnancy_panel_antepartum_visits"
        android:textColor="@color/nui_color_text_red"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btAddVisit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/nui_btnd_rone_gflat"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="10dp"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:maxLines="2"
        android:text="@string/pregnancy_panel_visit_add_bt_lbl"
        android:textSize="13sp"
        android:textAlignment="center"
        android:textStyle="bold"
        android:focusable="false"/>

</LinearLayout>
